# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas or local)
# Leave blank or set to mongodb+srv://<username>:<password>@cluster.mongodb.net/wedding_platform
MONGODB_URI=

# Authentication
JWT_SECRET=wedding_secret_key_change_in_production_2026

# Cloudinary (Media management for photos and videos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# AI Invitation Content Generator (Google Gemini API)
AI_API_KEY=
